# Supabase (free tier) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SMS provider — pick ONE and fill it in. Set SMS_PROVIDER=demo to run
# without any SMS account; messages are only printed in the Vercel
# function logs instead of actually being sent.
SMS_PROVIDER=onecodesoft

# --- Onecodesoft / OCS API (sms.ocs-api.top) — get api_key from your
#     Onecodesoft dashboard's Bulk SMS > API page. senderid must be an
#     APPROVED 11-digit Sender ID from the same page — it's required, the
#     request is rejected without one. ---
ONECODESOFT_API_KEY=
ONECODESOFT_SENDER_ID=
